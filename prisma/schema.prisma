generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Usuario {
  id                       Int             @id @default(autoincrement())
  email                    String          @unique
  password_hash            String
  rol                      Rol             @default(USER)
  nombrePublico            String?
  fotoPerfilUrl            String?         @db.VarChar(2048)
  biografia                String?         @db.VarChar(280)
  puntosAporte             Int             @default(0)
  calidadPromedio          Float?
  ultimoAcceso             DateTime?
  createdAt                DateTime        @default(now())
  aportes                  Aporte[]
  aportesModerados         Aporte[]        @relation("AporteModerador")
  publisherLinks           PublisherLink[]
  publisherTermsAcceptedAt DateTime?
}

model PublisherLink {
  id         Int                      @id @default(autoincrement())
  usuarioId  Int
  categoria  CategoriaEnlacePublisher
  plataforma String
  url        String
  usuario    Usuario                  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, categoria])
}

model Aporte {
  id                   Int          @id @default(autoincrement())
  tmdbId               String
  titulo               String?
  tipo                 String
  estado               EstadoAporte @default(PENDIENTE)
  usuarioId            Int
  calidadModeracion    Int?
  moderadoPorId        Int?
  moderadoEn           DateTime?
  comentarioModeracion String?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  usuario              Usuario      @relation(fields: [usuarioId], references: [id])
  moderadoPor          Usuario?     @relation("AporteModerador", fields: [moderadoPorId], references: [id])
  enlaces              Enlace[]
}

model Enlace {
  id                Int      @id @default(autoincrement())
  url               String
  servidor          String
  calidad           String?
  cantidad_reportes Int      @default(0)
  aporteId          Int
  createdAt         DateTime @default(now())
  aporte            Aporte   @relation(fields: [aporteId], references: [id])
}

enum Rol {
  USER
  PUBLISHER
  MODERATOR
  ADMIN
}

enum CategoriaEnlacePublisher {
  SOCIAL
  ALOJAMIENTO
}

enum EstadoAporte {
  PENDIENTE
  PUBLICADO
  RECHAZADO
  REVISION
}
