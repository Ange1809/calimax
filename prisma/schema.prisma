generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Rol {
  USER
  MODERATOR
}

model Usuario {
  id            String @id @default(uuid())
  email         String @unique
  password_hash String
  rol           Rol    @default(USER)
}
