datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Rol {
  USER
  MODERATOR
}

model Usuario {
  id        String   @id @default(uuid()) // <-- Cambiado a String para solucionar el error
  email     String   @unique             
  password  String                        
  rol       Rol      @default(USER)       
  createdAt DateTime @default(now())
  
  aportes   Aporte[]
}

enum EstadoAporte {
  PENDIENTE
  PUBLICADO
  RECHAZADO
}

enum EstadoEnlace {
  ACTIVO
  REVISION
}

model Aporte {
  id        String       @id @default(uuid()) // <-- Cambiado a String para solucionar el error
  tmdbId    String       
  estado    EstadoAporte @default(PENDIENTE) 
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  usuarioId String
  usuario   Usuario      @relation(fields: [usuarioId], references: [id])
  
  enlaces   Enlace[]
}

model Enlace {
  id       String       @id @default(uuid()) // <-- Cambiado a String para solucionar el error
  url      String       
  servidor String       
  reportes Int          @default(0) 
  estado   EstadoEnlace @default(ACTIVO)

  aporteId String
  aporte   Aporte       @relation(fields: [aporteId], references: [id], onDelete: Cascade)
}
