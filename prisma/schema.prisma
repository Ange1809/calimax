generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Usuario {
  id            Int      @id @default(autoincrement())
  email         String   @unique
  password_hash String
  rol           Rol      @default(USER)
  createdAt     DateTime @default(now())
  aportes       Aporte[]
}

model Aporte {
  id        Int          @id @default(autoincrement())
  tmdbId    String
  tipo      String
  estado    EstadoAporte @default(PENDIENTE)
  usuarioId Int
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  usuario   Usuario      @relation(fields: [usuarioId], references: [id])
  enlaces   Enlace[]
}

model Enlace {
  id                Int      @id @default(autoincrement())
  url               String
  servidor          String
  calidad           String?
  cantidad_reportes Int      @default(0)
  aporteId          Int
  createdAt         DateTime @default(now())
  aporte            Aporte   @relation(fields: [aporteId], references: [id])
}

enum Rol {
  USER
  MODERATOR
}

enum EstadoAporte {
  PENDIENTE
  PUBLICADO
  RECHAZADO
  REVISION
}
