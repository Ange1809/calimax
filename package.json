                         "axios":  "^1.6.8",
                         "bcrypt":  "^6.0.0",
                         "dotenv":  "^16.4.5",
                         "express":  "^4.19.2",
                         "jsonwebtoken":  "^9.0.3",
                         "node-cache":  "^5.1.2",
                         "zod":  "^3.23.8",
                         "swagger-ui-express":  "^5.0.0",
                         "yamljs":  "^0.3.0",
                         "cors":  "^2.8.5",
                         "express-rate-limit":  "^7.4.0"
                     },
    "devDependencies":  {
                            "@cucumber/cucumber":  "^10.8.0",
                            "@types/bcrypt":  "^6.0.0",
                            "@types/express":  "^4.17.21",
                            "@types/jsonwebtoken":  "^9.0.10",
                            "@types/supertest":  "^6.0.2",
                            "cross-env":  "^7.0.3",
                            "prisma":  "^5.22.0",
                            "supertest":  "^7.0.0",
                            "ts-node":  "^10.9.2",
                            "typescript":  "^5.5.3",
                            "@types/swagger-ui-express":  "^4.1.6",
                            "@types/yamljs":  "^0.2.34",
                            "jest":  "^29.7.0",
                            "ts-jest":  "^29.1.2",
                            "@types/jest":  "^29.5.12",
                            "@types/cors":  "^2.8.17"
                        }
}
