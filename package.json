{
  "name": "calimax",
  "version": "1.0.0",
  "description": "Backend API for Calimax",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "test:e2e": "cross-env NODE_OPTIONS=\"--loader ts-node/esm\" cucumber-js",
    "test:unit": "cross-env NODE_OPTIONS=\"--experimental-vm-modules\" jest",
    "dev": "node --loader ts-node/esm --env-file=.env src/server.ts",
    "start:cluster": "tsc && node --env-file=.env app.js"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "axios": "^1.6.8",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.5.1",
    "jsonwebtoken": "^9.0.3",
    "node-cache": "^5.1.2",
    "swagger-ui-express": "^5.0.0",
    "yamljs": "^0.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^10.8.0",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-rate-limit": "^5.1.3",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/supertest": "^6.0.2",
    "@types/swagger-ui-express": "^4.1.6",
    "@types/yamljs": "^0.2.34",
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "prisma": "^5.22.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.3"
  }
}
